    public SignaturesTest() { return; }

    static #String rsaJwk(String n, String e) {
        String j = "{\"kty\":\"RSA\",\"n\":\"" + n + "\",\"e\":\"" + e + "\"}";
        return #j;
    }

    static #String ecJwk(String crv, String x, String y) {
        String j = "{\"kty\":\"EC\",\"crv\":\"" + crv + "\",\"x\":\"" + x + "\",\"y\":\"" + y + "\"}";
        return #j;
    }

    /** The index of the second '.' in a compact JWS: the signing input ends there. */
    static int32 secondDot(String jws) {
        int32 seen = 0;
        int32 i = 0;
        while (i < jws.byteLength()) {
            if (jws.byteAt(i) == (int8) 46) {
                seen = seen + 1;
                if (seen == 2) { return i; }
            }
            i = i + 1;
        }
        return -1;
    }

    /** Verify a compact JWS against `key`, with `flip` = 0 none, 1 an input byte, 2 a signature byte. */
    static boolean verifyCompact(JwsAlgorithm alg, Jwk key, String jws, int32 flip) {
        int32 d = SignaturesTest.secondDot(jws);
        String inputText #= jws.substring(0, d);
        String sigText #= jws.substring(d + 1, jws.byteLength());
        int8[] input #= Bytes.ascii(inputText);
        int8[] sig #= Base64.decode(sigText);
        if (flip == 1) { input[3] = (int8) (input[3] ^ (int8) 1); }
        if (flip == 2) { sig[5] = (int8) (sig[5] ^ (int8) 1); }
        return Signatures.verify(alg, key, input, (int64) d, sig, sig.count());
    }

    static boolean verifyRaw(JwsAlgorithm alg, Jwk key, String msg, String sigB64) {
        int8[] input #= Bytes.ascii(msg);
        int8[] sig #= Base64.decode(sigB64);
        return Signatures.verify(alg, key, input, (int64) msg.byteLength(), sig, sig.count());
    }

    static boolean refused(String json) {
        boolean threw = false;
        try {
            Jwk k #= Jwk.parse(json);
        } catch (InvalidKeyException e) {
            threw = true;
        }
        return threw;
    }

    // 3.1.1: RFC 7515 A.2 verifies with the RFC's JWK and fails with one byte flipped.
    @Test
    public void rfc7515Rs256() {
        String j #= SignaturesTest.rsaJwk(SignaturesTest.RS256_N, "AQAB");
        Jwk key #= Jwk.parse(j);
        Assert.isTrue(key.isRsa());
        Assert.isTrue(SignaturesTest.verifyCompact(JwsAlgorithm.RS256, key, SignaturesTest.RS256_JWS, 0));
        Assert.isFalse(SignaturesTest.verifyCompact(JwsAlgorithm.RS256, key, SignaturesTest.RS256_JWS, 1));
        Assert.isFalse(SignaturesTest.verifyCompact(JwsAlgorithm.RS256, key, SignaturesTest.RS256_JWS, 2));
    }

    // 3.1.2: RFC 7515 A.3, the same for ES256.
    @Test
    public void rfc7515Es256() {
        String j #= SignaturesTest.ecJwk("P-256", SignaturesTest.ES256_X, SignaturesTest.ES256_Y);
        Jwk key #= Jwk.parse(j);
        Assert.isTrue(key.isEc());
        Assert.isTrue(SignaturesTest.verifyCompact(JwsAlgorithm.ES256, key, SignaturesTest.ES256_JWS, 0));
        Assert.isFalse(SignaturesTest.verifyCompact(JwsAlgorithm.ES256, key, SignaturesTest.ES256_JWS, 1));
        Assert.isFalse(SignaturesTest.verifyCompact(JwsAlgorithm.ES256, key, SignaturesTest.ES256_JWS, 2));
    }

    // 3.1.3: weak or foreign keys are refused when the key is built.
    @Test
    public void unusableKeysAreRefused() {
        String small #= SignaturesTest.rsaJwk(SignaturesTest.RSA1024_N, "AQAB");
        Assert.isTrue(SignaturesTest.refused(small));
        String p384 #= SignaturesTest.ecJwk("P-384", SignaturesTest.P384_X, SignaturesTest.P384_Y);
        Assert.isTrue(SignaturesTest.refused(p384));
        String off #= SignaturesTest.ecJwk("P-256", SignaturesTest.P256_X, SignaturesTest.OFFCURVE_Y);
        Assert.isTrue(SignaturesTest.refused(off));
        Assert.isTrue(SignaturesTest.refused("{\"kty\":\"EC\",\"crv\":\"P-256\",\"y\":\"" + SignaturesTest.P256_Y + "\"}"));
        Assert.isTrue(SignaturesTest.refused("{\"kty\":\"oct\",\"k\":\"AAAA\"}"));
        Assert.isTrue(SignaturesTest.refused("not json"));
    }

    // 3.1.4: a mismatched key type or a malformed signature answers false, never raises.
    @Test
    public void mismatchesAnswerFalse() {
        String rj #= SignaturesTest.rsaJwk(SignaturesTest.RS256_N, "AQAB");
        Jwk rsa #= Jwk.parse(rj);
        String ej #= SignaturesTest.ecJwk("P-256", SignaturesTest.ES256_X, SignaturesTest.ES256_Y);
        Jwk ec #= Jwk.parse(ej);
        Assert.isFalse(SignaturesTest.verifyCompact(JwsAlgorithm.RS256, ec, SignaturesTest.RS256_JWS, 0));
        Assert.isFalse(SignaturesTest.verifyCompact(JwsAlgorithm.ES256, rsa, SignaturesTest.ES256_JWS, 0));
        int8[] input #= Bytes.ascii("abc");
        int8[] s63 = heap int8[63];
        int8[] s65 = heap int8[65];
        int8[] none = heap int8[1];
        Assert.isFalse(Signatures.verify(JwsAlgorithm.ES256, ec, input, 3L, s63, 63L));
        Assert.isFalse(Signatures.verify(JwsAlgorithm.ES256, ec, input, 3L, s65, 65L));
        Assert.isFalse(Signatures.verify(JwsAlgorithm.ES256, ec, input, 3L, none, 0L));
        Assert.isFalse(Signatures.verify(JwsAlgorithm.RS256, rsa, input, 3L, none, 0L));
    }

    // 3.1.5: a JWK whose alg disagrees with the algorithm being checked answers false.
    @Test
    public void jwkAlgMustAgree() {
        String plain #= SignaturesTest.ecJwk("P-256", SignaturesTest.ES256_X, SignaturesTest.ES256_Y);
        Jwk ok #= Jwk.parse(plain);
        Assert.isTrue(SignaturesTest.verifyCompact(JwsAlgorithm.ES256, ok, SignaturesTest.ES256_JWS, 0));
        String tagged = "{\"kty\":\"EC\",\"crv\":\"P-256\",\"alg\":\"ES512\",\"x\":\""
            + SignaturesTest.ES256_X + "\",\"y\":\"" + SignaturesTest.ES256_Y + "\"}";
        Jwk wrong #= Jwk.parse(tagged);
        Assert.isTrue(wrong.alg().equals("ES512"));
        Assert.isFalse(SignaturesTest.verifyCompact(JwsAlgorithm.ES256, wrong, SignaturesTest.ES256_JWS, 0));
    }

    // 3.1.6: generated P-256 pairs sign, verify through their public JWK, and never publish d.
    @Test
    public void generatedPairSignsAndVerifies() {
        EcKeyPair a #= EcKeyPair.generateP256();
        EcKeyPair b #= EcKeyPair.generateP256();
        String ja #= a.publicJwk("k1");
        String jb #= b.publicJwk("k2");
        Assert.isFalse(ja.equals(jb));
        Assert.isTrue(ja.indexOf("\"d\"") < 0L);
        Assert.isTrue(ja.indexOf("\"kid\":\"k1\"") >= 0L);
        Assert.isTrue(ja.indexOf("\"alg\":\"ES256\"") >= 0L);
        Jwk ka #= Jwk.parse(ja);
        Assert.isTrue(ka.kid().equals("k1"));
        int8[] msg #= Bytes.ascii("header.payload");
        int8[] sig #= a.sign(msg, 14L);
        Assert.isTrue(sig.count() == 64L);
        Assert.isTrue(Signatures.verify(JwsAlgorithm.ES256, ka, msg, 14L, sig, 64L));
        sig[0] = (int8) (sig[0] ^ (int8) 1);
        Assert.isFalse(Signatures.verify(JwsAlgorithm.ES256, ka, msg, 14L, sig, 64L));
        Jwk kb #= Jwk.parse(jb);
        sig[0] = (int8) (sig[0] ^ (int8) 1);
        Assert.isFalse(Signatures.verify(JwsAlgorithm.ES256, kb, msg, 14L, sig, 64L));
    }

    // 3.1.7: a second source, a 3072-bit RSA key and a P-256 key generated outside cajeta.
    @Test
    public void secondSourceVectorsVerify() {
        String rj #= SignaturesTest.rsaJwk(SignaturesTest.RSA3072_N, "AQAB");
        Jwk rsa #= Jwk.parse(rj);
        Assert.isTrue(SignaturesTest.verifyRaw(JwsAlgorithm.RS256, rsa, SignaturesTest.GEN_MSG, SignaturesTest.RSA3072_SIG));
        String ej #= SignaturesTest.ecJwk("P-256", SignaturesTest.P256_X, SignaturesTest.P256_Y);
        Jwk ec #= Jwk.parse(ej);
        Assert.isTrue(SignaturesTest.verifyRaw(JwsAlgorithm.ES256, ec, SignaturesTest.GEN_MSG, SignaturesTest.P256_SIG));
        Assert.isFalse(SignaturesTest.verifyRaw(JwsAlgorithm.ES256, ec, "another message", SignaturesTest.P256_SIG));
    }
}
