    public SrpTest() {
        return;
    }

    @Test
    public void rfc5054MultiplierScrambleAndPrivateKey() {
        String k #= Srp.rfc5054K(SrpTest.N1024, "2");
        Assert.equals(SrpTest.RFC_K, k);
        String x #= Srp.rfc5054X(SrpTest.SALT1024, "alice", "password123");
        Assert.equals(SrpTest.RFC_X, x);
        String u #= Srp.rfc5054U(SrpTest.RFC_A, SrpTest.RFC_B, SrpTest.N1024);
        Assert.equals(SrpTest.RFC_U, u);
        return;
    }

    @Test
    public void rfc5054VerifierAndPublicValues() {
        String v #= Srp.modPowHex("2", SrpTest.RFC_X, SrpTest.N1024);
        Assert.equals(SrpTest.RFC_V, v);
        String a #= Srp.modPowHex("2", SrpTest.A_SECRET1024, SrpTest.N1024);
        Assert.equals(SrpTest.RFC_A, a);
        String b #= Srp.serverPublicHex(SrpTest.N1024, "2", SrpTest.RFC_K, SrpTest.RFC_V, SrpTest.B_SECRET1024);
        Assert.equals(SrpTest.RFC_B, b);
        return;
    }

    @Test
    public void rfc5054PremasterAgreesOnBothSides() {
        String client #= Srp.clientPremasterHex(SrpTest.N1024, "2", SrpTest.RFC_K, SrpTest.RFC_X,
            SrpTest.A_SECRET1024, SrpTest.RFC_U, SrpTest.RFC_B);
        Assert.equals(SrpTest.RFC_S, client);
        String server #= Srp.serverPremasterHex(SrpTest.N1024, SrpTest.RFC_A, SrpTest.RFC_V,
            SrpTest.RFC_U, SrpTest.B_SECRET1024);
        Assert.equals(SrpTest.RFC_S, server);
        return;
    }

    @Test
    public void cognitoGroupIsRfc3526Prime3072() {
        String n #= Srp.cognitoPrimeHex();
        Assert.equals(768L, (int64) n.byteLength());
        Assert.isTrue(n.indexOf("ffffffffffffffffc90fdaa22168c234") == 0L);
        Assert.isTrue(n.indexOf("a93ad2caffffffffffffffff") == 744L);
        return;
    }

    @Test
    public void cognitoClientPublicValue() {
        Srp srp = heap Srp(SrpTest.COG_A_SECRET);
        String a #= srp.publicHex();
        Assert.equals(SrpTest.COG_PUBLIC_A, a);
        return;
    }

    @Test
    public void cognitoServerSideMatchesTheReference() {
        String n #= Srp.cognitoPrimeHex();
        String v #= Srp.modPowHex("2", SrpTest.COG_X, n);
        Assert.equals(SrpTest.COG_V, v);
        String b #= Srp.serverPublicHex(n, "2", SrpTest.COG_K, SrpTest.COG_V, SrpTest.COG_B_SECRET);
        Assert.equals(SrpTest.COG_SERVER_B, b);
        return;
    }

    @Test
    public void cognitoPasswordKey() {
        Srp srp = heap Srp(SrpTest.COG_A_SECRET);
        int8[] key #= srp.passwordKey("ExAmPlE12", "4f3c2a10-9b7e-4d6a-8c21-0e5f7a9b3d14",
            "Correct-Horse-Battery-9", SrpTest.COG_SALT, SrpTest.COG_SERVER_B);
        Assert.equals(16L, key.count());
        Assert.isTrue(Bytes.equalsHex(key, 16, SrpTest.COG_HKDF));
        return;
    }

    @Test
    public void cognitoPasswordClaimSignature() {
        int8[] key #= Bytes.hex(SrpTest.COG_HKDF);
        int8[] block #= Bytes.hex(SrpTest.COG_SECRET_BLOCK);
        int8[] sig #= Srp.claim(key, "ExAmPlE12", "4f3c2a10-9b7e-4d6a-8c21-0e5f7a9b3d14",
            block, block.count(), "Thu Mar 5 07:04:09 UTC 2026");
        Assert.equals(32L, sig.count());
        Assert.isTrue(Bytes.equalsHex(sig, 32, SrpTest.COG_SIGNATURE));
        return;
    }

    @Test
    public void aServerValueOfZeroModNIsRefused() {
        Srp srp = heap Srp(SrpTest.COG_A_SECRET);
        String n #= Srp.cognitoPrimeHex();
        Assert.isTrue(SrpTest.refused(srp, n));
        Assert.isTrue(SrpTest.refused(srp, "0"));
        Assert.isTrue(SrpTest.refused(srp, "00" + n));
        return;
    }

    @Test
    public void aRandomSecretIsFreshEachTime() {
        Srp one #= Srp.random();
        Srp two #= Srp.random();
        String a1 #= one.publicHex();
        String a2 #= two.publicHex();
        Assert.isFalse(a1.equals(a2));
        Assert.isTrue(a1.byteLength() > 700);
        return;
    }

    // True when passwordKey refuses `b` as the server's value.
    private static boolean refused(Srp srp, String b) {
        try {
            int8[] key #= srp.passwordKey("ExAmPlE12", "user", "pw", SrpTest.COG_SALT, b);
        } catch (SrpException e) {
            return e.message.indexOf("B") >= 0L;
        }
        return false;
    }
}
