package dev.cajeta.crypto.selftest;

import cajeta.lang.String;
import dev.cajeta.crypto.HmacSha256;
import dev.cajeta.unit.Assert;

/** Ported from cajeta test/parser/CryptoPrimitivesTests.cpp (cajeta-crypto plan 2.1.1): RFC 4231. */
public class HmacSha256Test {

    public HmacSha256Test() { return; }

    static boolean mac(int8[] key, int32 keyLen, int8[] data, int32 dataLen, String want, boolean streaming) {
        if (!streaming) {
            int8[] m #= HmacSha256.mac(key, (int64) keyLen, data, (int64) dataLen);
            return Bytes.equalsHex(m, 32, want);
        }
        int32 half = dataLen / 2;
        HmacSha256 h = heap HmacSha256(key, (int64) keyLen);
        h.update(data, (int64) half);
        int8[] rest = heap int8[dataLen - half + 1];
        int32 j = 0;
        while (half + j < dataLen) { rest[j] = data[half + j]; j = j + 1; }
        h.update(rest, (int64) j);
        int8[] m #= h.digest();
        return Bytes.equalsHex(m, 32, want);
    }

    static boolean rfc4231(boolean s) {
        boolean ok = true;
        int8[] k1 #= Bytes.repeated((int8) 0x0b, 20);
        int8[] d1 #= Bytes.ascii("Hi There");
        ok = ok && HmacSha256Test.mac(k1, 20, d1, 8,
            "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7", s);
        int8[] k2 #= Bytes.ascii("Jefe");
        String t2 = "what do ya want for nothing?";
        int8[] d2 #= Bytes.ascii(t2);
        ok = ok && HmacSha256Test.mac(k2, 4, d2, t2.byteLength(),
            "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843", s);
        int8[] k3 #= Bytes.repeated((int8) 0xaa, 20);
        int8[] d3 #= Bytes.repeated((int8) 0xdd, 50);
        ok = ok && HmacSha256Test.mac(k3, 20, d3, 50,
            "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe", s);
        int8[] k4 = heap int8[25];
        int32 i = 0;
        while (i < 25) { k4[i] = (int8) (i + 1); i = i + 1; }
        int8[] d4 #= Bytes.repeated((int8) 0xcd, 50);
        ok = ok && HmacSha256Test.mac(k4, 25, d4, 50,
            "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b", s);
        int8[] k5 #= Bytes.repeated((int8) 0x0c, 20);
        int8[] d5 #= Bytes.ascii("Test With Truncation");
        ok = ok && HmacSha256Test.mac(k5, 20, d5, 20,
            "a3b6167473100ee06e0c796c2955552bfa6f7c0a6a8aef8b93f860aab0cd20c5", s);
        int8[] k6 #= Bytes.repeated((int8) 0xaa, 131);
        String t6 = "Test Using Larger Than Block-Size Key - Hash Key First";
        int8[] d6 #= Bytes.ascii(t6);
        ok = ok && HmacSha256Test.mac(k6, 131, d6, t6.byteLength(),
            "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54", s);
        String t7 = "This is a test using a larger than block-size key and a larger than block-size data. "
            + "The key needs to be hashed before being used by the HMAC algorithm.";
        int8[] d7 #= Bytes.ascii(t7);
        ok = ok && HmacSha256Test.mac(k6, 131, d7, t7.byteLength(),
            "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2", s);
        return ok;
    }

    @Test
    public void rfc4231VectorsOneShot() {
        Assert.isTrue(HmacSha256Test.rfc4231(false));
    }

    @Test
    public void rfc4231VectorsStreaming() {
        Assert.isTrue(HmacSha256Test.rfc4231(true));
    }

    @Test
    public void resetReusesTheKey() {
        int8[] key #= Bytes.ascii("Jefe");
        int8[] a #= Bytes.ascii("first");
        int8[] b #= Bytes.ascii("what do ya want for nothing?");
        HmacSha256 h = heap HmacSha256(key, 4L);
        h.update(a, 5L);
        int8[] first #= h.digest();
        h.reset();
        h.update(b, 28L);
        int8[] out #= h.digest();
        Assert.isTrue(Bytes.equalsHex(out, 32, "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"));
    }
}
