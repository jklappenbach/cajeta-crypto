package dev.cajeta.crypto.selftest;

import cajeta.lang.String;
import cajeta.error.Exception;
import cajeta.io.net.ByteBuffer;
import cajeta.io.net.IpAddress;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpStream;
import cajeta.io.net.TcpListener;
import cajeta.io.net.TimedOutException;
import cajeta.io.net.reactor.Reactor;
import cajeta.io.net.reactor.ReadySet;
import cajeta.concurrent.Tasks;
import dev.cajeta.crypto.tls.TlsConnection;
import dev.cajeta.crypto.tls.TlsStream;
import dev.cajeta.unit.Assert;

/**
 * cajeta-crypto plan 4.1.1: TLS over a loopback socket, ported from cajeta's
 * TlsLoopbackTest. A client TlsStream and a server on its own fiber run the
 * memory-BIO pump against TcpStream, parking on the reactor. Each scenario
 * returns 1 on success and a distinct negative code at the step that failed,
 * as the C++ originals did. The original's crossCarrierFiberHolderDropRegression
 * uses no TLS; it stays with the scheduler tests in cajeta.
 */
public class TlsLoopbackTest {

    public TlsLoopbackTest() { return; }

    // --- handshake and echo ----------------------------------------------------

    public static async int32 echoServer(#TcpStream sock) {
        int8[] cert #= Bytes.ascii(TestCerts.LOCALHOST_CERT);
        int8[] key #= Bytes.ascii(TestCerts.LOCALHOST_KEY);
        TlsStream st #= TlsStream.server(#sock, cert, TestCerts.LOCALHOST_CERT.byteLength(),
                                         key, TestCerts.LOCALHOST_KEY.byteLength());
        st.handshake();
        int8[] inbuf = heap int8[256];
        int32 n = st.read(inbuf, 256);
        st.write(inbuf, n);
        return n;
    }

    static int32 handshakeAndEcho() {
        () -> int32 body = () -> {
            int8[] trust #= Bytes.ascii(TestCerts.LOCALHOST_CERT);
            int8[] host #= Bytes.ascii("localhost");
            IpAddress la #= IpAddress.loopbackV4();
            SocketAddress bindAddr #= SocketAddress.of(#la, 0);
            TcpListener listener #= TcpListener.bind(bindAddr);
            int32 port = listener.boundPort();
            if (port <= 0) { return -1; }
            IpAddress ca #= IpAddress.loopbackV4();
            SocketAddress connAddr #= SocketAddress.of(#ca, port);
            TcpStream client #= TcpStream.connect(#connAddr);
            TcpStream server #= listener.accept();
            Task<int32> serverTask = spawn echoServer(#server);
            TlsStream ct #= TlsStream.client(#client, host, 9, trust, TestCerts.LOCALHOST_CERT.byteLength());
            ct.handshake();
            int8[] ping #= Bytes.ascii("ping");
            ct.write(ping, 4);
            int8[] echo = heap int8[256];
            int32 got = ct.read(echo, 256);
            int32 sret = await serverTask;
            listener.close();
            if (sret != 4) { return -2; }
            if (got != 4) { return -3; }
            int32 i = 0;
            while (i < 4) {
                if (echo[i] != ping[i]) { return -4; }
                i = i + 1;
            }
            return 1;
        };
        return Tasks.runBlocking<int32>(body);
    }

    // A full handshake and plaintext echo over a loopback socket, each side on its own fiber.
    @Test
    public void tlsHandshakeAndEchoOverLoopback() {
        Assert.equals(1L, (int64) TlsLoopbackTest.handshakeAndEcho());
    }

    // --- readWithin deadline ---------------------------------------------------

    public static async int32 quietServer(#TcpStream sock) {
        int8[] cert #= Bytes.ascii(TestCerts.LOCALHOST_CERT);
        int8[] key #= Bytes.ascii(TestCerts.LOCALHOST_KEY);
        TlsStream st #= TlsStream.server(#sock, cert, TestCerts.LOCALHOST_CERT.byteLength(),
                                         key, TestCerts.LOCALHOST_KEY.byteLength());
        st.handshake();
        int8[] sink = heap int8[16];
        int32 n = st.read(sink, 16);
        return n;
    }

    static int32 readWithinDeadline() {
        () -> int32 body = () -> {
            int8[] trust #= Bytes.ascii(TestCerts.LOCALHOST_CERT);
            int8[] host #= Bytes.ascii("localhost");
            IpAddress la #= IpAddress.loopbackV4();
            SocketAddress bindAddr #= SocketAddress.of(#la, 0);
            TcpListener listener #= TcpListener.bind(bindAddr);
            int32 port = listener.boundPort();
            if (port <= 0) { return -1; }
            IpAddress ca #= IpAddress.loopbackV4();
            SocketAddress connAddr #= SocketAddress.of(#ca, port);
            TcpStream client #= TcpStream.connect(#connAddr);
            TcpStream server #= listener.accept();
            Task<int32> serverTask = spawn quietServer(#server);
            TlsStream ct #= TlsStream.client(#client, host, 9, trust, TestCerts.LOCALHOST_CERT.byteLength());
            ct.handshake();
            int8[] buf = heap int8[64];
            int64 n = -1L;
            int64 t0 = Reactor.nowMillis();
            boolean timedOut = false;
            try {
                n = ct.readWithin(buf, 0L, 64L, 400);
            } catch (TimedOutException e) {
                timedOut = true;
            }
            int64 elapsed = Reactor.nowMillis() - t0;
            ct.close();
            int32 sret = await serverTask;
            listener.close();
            if (!timedOut) { return -2; }
            if (n >= 0L) { return -3; }
            if (elapsed < 300L) { return -4; }
            if (elapsed >= 8000L) { return -5; }
            return 1;
        };
        return Tasks.runBlocking<int32>(body);
    }

    // readWithin honours its deadline against a handshaked peer that goes quiet,
    // neither returning early nor waiting forever.
    @Test
    public void readWithinHonoursDeadline() {
        Assert.equals(1L, (int64) TlsLoopbackTest.readWithinDeadline());
    }

    // --- full duplex -----------------------------------------------------------

    public static async int32 pump(TlsStream st, int32 total) {
        int8[] chunk = heap int8[16384];
        int32 sent = 0;
        try {
            while (sent < total) {
                int32 n = total - sent;
                if (n > 16384) { n = 16384; }
                int32 i = 0;
                while (i < n) { chunk[i] = (int8) ((sent + i) % 251); i = i + 1; }
                st.write(chunk, n);
                sent = sent + n;
            }
        } catch (Exception e) {
            return -20;
        }
        return sent;
    }

    static int32 drain(TlsStream st, int32 total) {
        int8[] in = heap int8[16384];
        int32 got = 0;
        try {
            while (got < total) {
                int32 n = st.read(in, 16384);
                if (n <= 0) { return -10; }
                int32 i = 0;
                while (i < n) {
                    if (in[i] != (int8) ((got + i) % 251)) { return -11; }
                    i = i + 1;
                }
                got = got + n;
            }
        } catch (Exception e) {
            return -12;
        }
        return got;
    }

    static int32 duplex(TlsStream st, int32 total) {
        int32 got = 0;
        int32 sent = 0;
        scope {
            Task<int32> w = spawn pump(st, total);
            got = TlsLoopbackTest.drain(st, total);
            if (got != total) { try { st.close(); } catch (Exception e) { } }
            sent = await w;
        }
        if (sent != total) { return sent; }
        return got;
    }

    public static async int32 duplexServer(#TcpStream sock, int32 total) {
        int8[] cert #= Bytes.ascii(TestCerts.LOCALHOST_CERT);
        int8[] key #= Bytes.ascii(TestCerts.LOCALHOST_KEY);
        TlsStream st #= TlsStream.server(#sock, cert, TestCerts.LOCALHOST_CERT.byteLength(),
                                         key, TestCerts.LOCALHOST_KEY.byteLength());
        st.handshake();
        return TlsLoopbackTest.duplex(st, total);
    }

    static int32 fullDuplex() {
        () -> int32 body = () -> {
            int8[] trust #= Bytes.ascii(TestCerts.LOCALHOST_CERT);
            int8[] host #= Bytes.ascii("localhost");
            int32 total = 4194304;
            IpAddress la #= IpAddress.loopbackV4();
            SocketAddress bindAddr #= SocketAddress.of(#la, 0);
            TcpListener listener #= TcpListener.bind(bindAddr);
            int32 port = listener.boundPort();
            if (port <= 0) { return -1; }
            IpAddress ca #= IpAddress.loopbackV4();
            SocketAddress connAddr #= SocketAddress.of(#ca, port);
            TcpStream client #= TcpStream.connect(#connAddr);
            TcpStream server #= listener.accept();
            Task<int32> serverTask = spawn duplexServer(#server, total);
            TlsStream ct #= TlsStream.client(#client, host, 9, trust, TestCerts.LOCALHOST_CERT.byteLength());
            ct.handshake();
            int32 cr = TlsLoopbackTest.duplex(ct, total);
            if (cr != total) { try { ct.close(); } catch (Exception e) { } }
            int32 sr = await serverTask;
            listener.close();
            if (cr != total) { return 1000 + cr; }
            if (sr != total) { return 2000 + sr; }
            return 1;
        };
        return Tasks.runBlocking<int32>(body);
    }

    // One TlsStream carries a reading fiber and a writing fiber at once, as an h2
    // connection does: 4 MB each way, every byte intact.
    @Test
    public void fullDuplexBulkKeepsBothDirectionsIntact() {
        Assert.equals(1L, (int64) TlsLoopbackTest.fullDuplex());
    }

    // --- the framer's non-parking entries --------------------------------------

    public static async int32 framerServer(#TcpStream sock) {
        int8[] cert #= Bytes.ascii(TestCerts.LOCALHOST_CERT);
        int8[] key #= Bytes.ascii(TestCerts.LOCALHOST_KEY);
        TlsStream st #= TlsStream.server(#sock, cert, TestCerts.LOCALHOST_CERT.byteLength(),
                                         key, TestCerts.LOCALHOST_KEY.byteLength());
        ReadySet set = heap ReadySet();
        set.add(st.fd(), ReadySet.READ);
        int32[] fds = heap int32[4];
        int32[] evs = heap int32[4];
        boolean done = false;
        int32 spins = 0;
        while (!done && spins < 4000) {
            int32 r = st.handshakeNow();
            if (r == TlsConnection.OK) {
                done = true;
            } else if (r == TlsConnection.FAILED) {
                return -20;
            } else {
                int32 n = st.fillNow();
                if (n == 0) { return -21; }
                if (n < 0) { set.wait(fds, evs, 4, 2000); }
            }
            spins = spins + 1;
        }
        if (!done) { return -24; }
        ByteBuffer plain = heap ByteBuffer(256);
        spins = 0;
        while (plain.readable() < 4 && spins < 4000) {
            int32 n = st.readPlaintextNow(plain);
            if (n < 0) { return -22; }
            if (n == 0) {
                int32 f = st.fillNow();
                if (f == 0) { return -23; }
                if (f < 0) { set.wait(fds, evs, 4, 2000); }
            }
            spins = spins + 1;
        }
        int32 got = plain.readable();
        if (!st.writeNow(plain.array(), plain.readPosition(), got)) { return -25; }
        set.close();
        return got;
    }

    static int32 framerEntries() {
        () -> int32 body = () -> {
            int8[] trust #= Bytes.ascii(TestCerts.LOCALHOST_CERT);
            int8[] host #= Bytes.ascii("localhost");
            IpAddress la #= IpAddress.loopbackV4();
            SocketAddress bindAddr #= SocketAddress.of(#la, 0);
            TcpListener listener #= TcpListener.bind(bindAddr);
            int32 port = listener.boundPort();
            if (port <= 0) { return -1; }
            IpAddress ca #= IpAddress.loopbackV4();
            SocketAddress connAddr #= SocketAddress.of(#ca, port);
            TcpStream client #= TcpStream.connect(#connAddr);
            TcpStream server #= listener.accept();
            Task<int32> serverTask = spawn framerServer(#server);
            TlsStream ct #= TlsStream.client(#client, host, 9, trust, TestCerts.LOCALHOST_CERT.byteLength());
            boolean clientOk = true;
            try {
                ct.handshake();
            } catch (Exception e) {
                clientOk = false;
            }
            int32 got = -1;
            int8[] ping #= Bytes.ascii("ping");
            int8[] echo = heap int8[256];
            if (clientOk) {
                ct.write(ping, 4);
                got = ct.read(echo, 256);
            } else {
                ct.close();
            }
            int32 sret = await serverTask;
            listener.close();
            if (!clientOk) { return sret * 100 - 50; }
            if (sret != 4) { return sret * 100 - 2; }
            if (got != 4) { return -3; }
            int32 i = 0;
            while (i < 4) {
                if (echo[i] != ping[i]) { return -4; }
                i = i + 1;
            }
            return 1;
        };
        return Tasks.runBlocking<int32>(body);
    }

    // A framer drives TLS without parking: feed what readNow read, step the
    // handshake, decrypt into the connection buffer and seal its own reply.
    @Test
    public void framerSideEntriesHandshakeAndDecryptWithoutParking() {
        Assert.equals(1L, (int64) TlsLoopbackTest.framerEntries());
    }
}
