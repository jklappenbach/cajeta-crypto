package cryptotour;

import cajeta.lang.String;
import cajeta.io.net.IpAddress;
import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpListener;
import cajeta.io.net.TcpStream;
import cajeta.concurrent.Tasks;
import dev.cajeta.crypto.tls.CertificateInvalidException;
import dev.cajeta.crypto.tls.TlsConnection;
import dev.cajeta.crypto.tls.TlsException;
import dev.cajeta.crypto.tls.TlsListener;
import dev.cajeta.crypto.tls.TlsStream;

/**
 * The TLS section of the tour: a real handshake and echo over 127.0.0.1, a
 * hostname the certificate does not name, and the memory pump underneath.
 *
 * There is no insecure skip-verify mode. A client names the host it expects
 * and the anchors it trusts; here the self-signed TourCert is both the
 * server's certificate and the client's trust anchor. accept() and handshake()
 * park their fibers, so the server side is spawned and awaited.
 */
final class TlsTour {

    /** The server end: TlsListener.accept() is the TCP accept plus the server handshake. */
    public static async int32 serveOne(#TlsListener listener) {
        TlsStream s #= listener.accept();
        int8[] buf = heap int8[256];
        int32 n = s.read(buf, 256);
        s.write(buf, n);
        return n;
    }

    /** A server whose client walks away mid-handshake sees a TlsException. */
    public static async int32 refusedBy(#TcpStream sock) {
        int8[] cert #= TourCert.LOCALHOST_CERT.toBytes();
        int8[] key #= TourCert.LOCALHOST_KEY.toBytes();
        TlsStream s #= TlsStream.server(#sock, cert, TourCert.LOCALHOST_CERT.byteLength(),
                                        key, TourCert.LOCALHOST_KEY.byteLength());
        try {
            s.handshake();
        } catch (TlsException e) {
            return 1;
        }
        return 0;
    }

    static void echo() {
        () -> int32 body = () -> {
            int8[] cert #= TourCert.LOCALHOST_CERT.toBytes();
            int8[] key #= TourCert.LOCALHOST_KEY.toBytes();
            int32 cl = TourCert.LOCALHOST_CERT.byteLength();
            int32 kl = TourCert.LOCALHOST_KEY.byteLength();
            String hostName = "localhost";
            int8[] host #= hostName.toBytes();

            IpAddress la #= IpAddress.loopbackV4();
            SocketAddress bindAddr #= SocketAddress.of(#la, 0);
            TlsListener listener #= TlsListener.bind(bindAddr, cert, cl, key, kl);
            int32 port = listener.boundPort();
            IpAddress ca #= IpAddress.loopbackV4();
            SocketAddress connAddr #= SocketAddress.of(#ca, port);
            TcpStream client #= TcpStream.connect(#connAddr);
            Task<int32> served = spawn serveOne(#listener);

            TlsStream ct #= TlsStream.client(#client, host, 9, cert, cl);
            ct.handshake();
            String pingText = "ping";
            int8[] ping #= pingText.toBytes();
            ct.write(ping, 4);
            int8[] back = heap int8[256];
            int32 got = ct.read(back, 256);
            int32 sent = await served;
            ct.closeNotify();
            ct.close();
            boolean same = got == 4;
            int32 i = 0;
            while (same && i < 4) {
                if (back[i] != ping[i]) { same = false; }
                i = i + 1;
            }
            CryptoTour.check(sent == 4 && same, "a TLS echo over 127.0.0.1, hostname localhost verified");
            return 0;
        };
        Tasks.runBlocking<int32>(body);
    }

    static void wrongHost() {
        () -> int32 body = () -> {
            int8[] cert #= TourCert.LOCALHOST_CERT.toBytes();
            String hostName = "wrong.test";
            int8[] host #= hostName.toBytes();
            IpAddress la #= IpAddress.loopbackV4();
            SocketAddress bindAddr #= SocketAddress.of(#la, 0);
            TcpListener listener #= TcpListener.bind(bindAddr);
            IpAddress ca #= IpAddress.loopbackV4();
            SocketAddress connAddr #= SocketAddress.of(#ca, listener.boundPort());
            TcpStream client #= TcpStream.connect(#connAddr);
            TcpStream server #= listener.accept();
            Task<int32> refused = spawn refusedBy(#server);

            TlsStream ct #= TlsStream.client(#client, host, hostName.byteLength(),
                                             cert, TourCert.LOCALHOST_CERT.byteLength());
            int32 reason = -1;
            try {
                ct.handshake();
            } catch (CertificateInvalidException e) {
                reason = e.getReason();
            }
            ct.close();
            int32 serverSaw = await refused;
            listener.close();
            CryptoTour.check(reason == TlsConnection.CERT_HOSTNAME,
                "a certificate for localhost fails a client expecting wrong.test: CertificateInvalidException");
            CryptoTour.check(serverSaw == 1, "and the server's handshake ends in a TlsException");
            return 0;
        };
        Tasks.runBlocking<int32>(body);
    }

    /** No socket at all: two TlsConnections and the ciphertext moved by hand. */
    static void memoryPump() {
        int8[] cert #= TourCert.LOCALHOST_CERT.toBytes();
        int8[] key #= TourCert.LOCALHOST_KEY.toBytes();
        TlsConnection server #= TlsConnection.server(cert, TourCert.LOCALHOST_CERT.byteLength(),
                                                     key, TourCert.LOCALHOST_KEY.byteLength());
        TlsConnection client #= TlsConnection.verifyingClient();
        client.addTrust(cert, TourCert.LOCALHOST_CERT.byteLength());
        String hostName = "localhost";
        int8[] host #= hostName.toBytes();
        client.setVerifyHost(host, 9);
        int8[] wire = heap int8[16384];
        boolean done = false;
        int32 round = 0;
        while (!done && round < 64) {
            int32 cs = client.handshakeStep();
            int32 n = client.pull(wire, 16384);
            while (n > 0) { server.feed(wire, n); n = client.pull(wire, 16384); }
            int32 ss = server.handshakeStep();
            n = server.pull(wire, 16384);
            while (n > 0) { client.feed(wire, n); n = server.pull(wire, 16384); }
            if (cs == TlsConnection.OK && ss == TlsConnection.OK) { done = true; }
            round = round + 1;
        }
        CryptoTour.check(done && client.verifyResult() == TlsConnection.CERT_OK,
            "the memory pump: a verified handshake with no socket, ciphertext moved by hand");
    }

    static void run() {
        System.stdout.println("TLS");
        TlsTour.echo();
        TlsTour.wrongHost();
        TlsTour.memoryPump();
    }
}
